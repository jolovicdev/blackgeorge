#!/usr/bin/env bash
set -euo pipefail

if [ ! -f pyproject.toml ]; then
    exit 0
fi

toml_version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' pyproject.toml | head -1)"
if [ -z "${toml_version}" ]; then
    echo "pre-push: unable to read version from pyproject.toml" >&2
    exit 1
fi

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "${local_ref}" ]; then
        continue
    fi

    case "${local_ref}" in
        refs/tags/v*)
            tag_name="${local_ref#refs/tags/}"
            tag_version="${tag_name#v}"
            if [ "${tag_version}" != "${toml_version}" ]; then
                echo "pre-push: ${tag_name} does not match pyproject.toml version ${toml_version}" >&2
                blocked=1
                continue
            fi

            tag_commit="$(git rev-list -n 1 "${local_ref}")"
            if git show-ref --verify --quiet refs/remotes/origin/master; then
                if ! git merge-base --is-ancestor "${tag_commit}" refs/remotes/origin/master; then
                    echo "pre-push: ${tag_name} must point to a commit contained in origin/master" >&2
                    blocked=1
                fi
            elif ! git merge-base --is-ancestor "${tag_commit}" master 2>/dev/null; then
                echo "pre-push: ${tag_name} must point to a commit contained in master" >&2
                blocked=1
            fi
            ;;
    esac
done

if [ "${blocked}" -ne 0 ]; then
    exit 1
fi
